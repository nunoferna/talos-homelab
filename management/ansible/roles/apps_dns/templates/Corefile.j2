{{ apps_dns_site.domain }}:53 {
    bind {{ apps_dns_site.listen_ipv4 }}
    acl {
        allow net {{ apps_dns_site.allowed_clients | join(' ') }}
        block
    }
    errors
    file {{ apps_dns_configuration_directory }}/apps.internal.zone {{ apps_dns_site.domain }}
    cache 30
    reload 30s
}
