#!/bin/bash
# Strict read-only client double; no network or credential contents.
set -euo pipefail
test "$1" = --kubeconfig
test "$2" = "$LONGHORN_KUBECONFIG"
test "$3" = --context
test "$4" = fixture
shift 4
case "$*" in
  'config view --minify -o=jsonpath={.clusters[0].cluster.server}')
    printf '%s' "${LONGHORN_FIXTURE_SERVER:-https://192.0.2.70:6443}"
    ;;
  'get namespace kube-system -o=jsonpath={.metadata.uid}')
    printf '%s' "${LONGHORN_FIXTURE_UID:-11111111-1111-1111-1111-111111111111}"
    ;;
  'get nodes -o=json')
    jq -n --arg version "${LONGHORN_FIXTURE_NODE_VERSION:-v1.14.1}" \
      --arg address "${LONGHORN_FIXTURE_NODE_ADDRESS:-192.0.2.1}" \
      --arg ready "${LONGHORN_FIXTURE_NODE_READY:-True}" \
      --arg kubelet "${LONGHORN_FIXTURE_KUBELET:-v1.37.0}" '
      {items: [range(1; 4) | . as $n | {
        metadata: {name: ("fixture0" + ($n | tostring))},
        status: {
          nodeInfo: {osImage: ("Talos (" + $version + ")"), kubeletVersion: $kubelet},
          addresses: [{type: "InternalIP", address:
            (if $n == 1 then $address else "192.0.2." + ($n | tostring) end)}],
          conditions: [{type: "Ready", status: $ready}]
        }
      }]}'
    ;;
  '--namespace=kube-system rollout status daemonset/cilium --timeout=30s')
    test "${LONGHORN_FIXTURE_CILIUM:-pass}" = pass
    ;;
  '--namespace=flux-system get kustomizations.kustomize.toolkit.fluxcd.io -o=json')
    if test "${LONGHORN_FIXTURE_FLUX:-True}" = absent; then
      printf '{"items": []}\n'
      exit 0
    fi
    jq -n --arg ready "${LONGHORN_FIXTURE_FLUX:-True}" \
      --argjson observed "${LONGHORN_FIXTURE_FLUX_GENERATION:-1}" '
      {items: [{metadata: {name: "fixture", generation: 1}, status: {
        conditions: [{type: "Ready", status: $ready, observedGeneration: $observed}]
      }}]}'
    ;;
  *) exit 1 ;;
esac
